MONGO_URL=mongodb://localhost:27017
DB_NAME=cloudcostiq
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Primary AI: self-hosted Ollama (Oracle Free Tier VM or local).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Backup AI: OpenAI-compatible free API (used automatically when Ollama fails).
# Set FREE_AI_API_KEY to enable. Set ENABLE_FREE_AI=false to force rules-only backup.
ENABLE_FREE_AI=true
FREE_AI_BASE_URL=https://openrouter.ai/api/v1
FREE_AI_MODEL=openrouter/free
FREE_AI_API_KEY=
FREE_AI_HTTP_REFERER=http://localhost:3000
FREE_AI_APP_TITLE=CloudCost IQ

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
